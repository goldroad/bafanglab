# bafanglab - 跨平台行尾与文件类型规范
# 版权所有：八方网域-无涯
#
# 目的：
#   1. 统一文本文件为 LF，防止 Windows 检出时 git 自动转换成 CRLF；
#   2. 重点保护 shell 脚本：entrypoint.sh / deploy.sh 一旦被 CRLF 污染，
#      Docker 容器会因 `exec format error` 反复重启（见 README 第三节第 8 节 FAQ）；
#   3. 明确二进制文件，禁止 git 做任何行尾/编码转换。

# 默认：按内容自动判断文本/二进制，仓库内统一 LF
* text=auto eol=lf

# 明确声明为文本、强制 LF
*.php    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.cnf    text eol=lf
*.sql    text eol=lf
*.xml    text eol=lf
*.svg    text eol=lf
*.gitignore   text eol=lf
*.gitattributes  text eol=lf
*.dockerignore  text eol=lf

# Windows 批处理必须保留 CRLF（如未来加入 .bat/.cmd）
# *.bat  text eol=crlf
# *.cmd  text eol=crlf

# 二进制文件：不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
